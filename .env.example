PORT=3001
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DOMAIN=http://localhost:3001/

DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodfight
DB_USER=foodfight
DB_PASSWORD=foodfight
DB_SSL=false

# Optional — leave blank to hide Google sign-in (local email/password still works)
# In Google Cloud Console, add authorized redirect URI:
#   {DOMAIN}/auth/google/callback   e.g. http://localhost:3001/auth/google/callback
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GMAIL_ADDRESS=
GMAIL_PASSWORD=
YELP_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
